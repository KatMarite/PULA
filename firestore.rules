rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Hardened Global Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Zero-lookup admin check safe for allow list rules (Cost-Optimization Clause)
    function isVerifiedAdminEmail() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'katlehomarite@gmail.com';
    }

    // Full RBAC admin check for single-document operations
    function isAdmin() {
      return isVerifiedAdminEmail() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidEdition(data) {
      return data.keys().hasAll([
          'id', 'code', 'name', 'subtitle', 'description',
          'price', 'volume', 'badge', 'stockCount', 'sortOrder', 'active', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'code', 'name', 'subtitle', 'description',
          'price', 'compareAtPrice', 'volume', 'badge', 'stockCount', 'sortOrder', 'active', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 40 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 10 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.subtitle is string && data.subtitle.size() >= 1 && data.subtitle.size() <= 100 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 400 &&
        data.price is int && data.price >= 1 && data.price <= 100000 &&
        (!('compareAtPrice' in data) || (data.compareAtPrice is int && data.compareAtPrice >= 0 && data.compareAtPrice <= 100000)) &&
        data.volume is string && data.volume.size() >= 1 && data.volume.size() <= 40 &&
        data.badge is string && data.badge.size() >= 1 && data.badge.size() <= 30 &&
        data.stockCount is int && data.stockCount >= 0 && data.stockCount <= 10000 &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100 &&
        data.active is bool &&
        data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'userId', 'displayName', 'beardStage', 'dailyDrops', 'bottleDropsRemaining',
          'streakDays', 'lastRitualDate', 'savedArea', 'fulfillmentPref',
          'cartSingle', 'cartTwin', 'cartKit', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'displayName', 'beardStage', 'dailyDrops', 'bottleDropsRemaining',
          'streakDays', 'lastRitualDate', 'savedArea', 'fulfillmentPref',
          'cartSingle', 'cartTwin', 'cartKit', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.displayName is string && data.displayName.size() <= 80 &&
        data.beardStage is string && data.beardStage.size() <= 16 &&
        data.beardStage in ['stubble', 'short', 'medium', 'full'] &&
        data.dailyDrops is number && data.dailyDrops >= 1 && data.dailyDrops <= 20 &&
        data.bottleDropsRemaining is number && data.bottleDropsRemaining >= 0 && data.bottleDropsRemaining <= 600 &&
        data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 3650 &&
        data.lastRitualDate is string && data.lastRitualDate.size() <= 20 &&
        data.lastRitualDate.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$') &&
        data.savedArea is string && data.savedArea.size() <= 100 &&
        data.fulfillmentPref is string && data.fulfillmentPref.size() <= 16 &&
        data.fulfillmentPref in ['pickup', 'delivery'] &&
        data.cartSingle is number && data.cartSingle >= 0 && data.cartSingle <= 20 &&
        data.cartTwin is number && data.cartTwin >= 0 && data.cartTwin <= 20 &&
        data.cartKit is number && data.cartKit >= 0 && data.cartKit <= 20 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRitualLog(data) {
      return data.keys().hasAll(['userId', 'dateKey', 'beardStage', 'dropsUsed', 'note', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'dateKey', 'beardStage', 'dropsUsed', 'note', 'createdAt']) &&
        isValidId(data.userId) &&
        data.dateKey is string && data.dateKey.size() == 10 &&
        data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.beardStage is string && data.beardStage.size() <= 16 &&
        data.beardStage in ['stubble', 'short', 'medium', 'full'] &&
        data.dropsUsed is number && data.dropsUsed >= 1 && data.dropsUsed <= 20 &&
        data.note is string && data.note.size() <= 240 &&
        data.createdAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber', 'userId', 'customerName', 'customerArea', 'customerPhone',
          'qtySingle', 'qtyTwin', 'qtyKit', 'fulfillment', 'paymentMethod',
          'subtotal', 'deliveryFee', 'total', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'orderNumber', 'userId', 'customerName', 'customerArea', 'customerPhone',
          'qtySingle', 'qtyTwin', 'qtyKit', 'fulfillment', 'paymentMethod',
          'subtotal', 'deliveryFee', 'total', 'notes', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.orderNumber is string && data.orderNumber.size() >= 6 && data.orderNumber.size() <= 32 &&
        data.orderNumber.matches('^PULA-[A-Z0-9\\-]+$') &&
        isValidId(data.userId) &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 80 &&
        data.customerArea is string && data.customerArea.size() >= 2 && data.customerArea.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() <= 30 &&
        data.qtySingle is int && data.qtySingle >= 0 && data.qtySingle <= 20 &&
        data.qtyTwin is int && data.qtyTwin >= 0 && data.qtyTwin <= 20 &&
        data.qtyKit is int && data.qtyKit >= 0 && data.qtyKit <= 20 &&
        (data.qtySingle + data.qtyTwin + data.qtyKit) >= 1 &&
        data.fulfillment is string && data.fulfillment.size() <= 16 &&
        data.fulfillment in ['pickup', 'delivery'] &&
        data.paymentMethod is string && data.paymentMethod.size() <= 16 &&
        data.paymentMethod in ['mpesa', 'ecocash', 'eft', 'cash'] &&
        data.subtotal is int && data.subtotal >= 1 && data.subtotal <= 100000 &&
        data.deliveryFee is int && data.deliveryFee == (data.fulfillment == 'delivery' ? 30 : 0) &&
        data.total is int && data.total == (data.subtotal + data.deliveryFee) &&
        data.notes is string && data.notes.size() <= 300 &&
        data.status is string && data.status.size() <= 20 &&
        data.status in ['pending', 'confirmed', 'pouring', 'ready', 'delivered', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBarberInquiry(data) {
      return data.keys().hasAll([
          'userId', 'requestType', 'shopName', 'contactName',
          'location', 'chairs', 'phone', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'requestType', 'shopName', 'contactName',
          'location', 'chairs', 'phone', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.requestType is string && data.requestType.size() <= 20 &&
        data.requestType in ['tester', 'wholesale'] &&
        data.shopName is string && data.shopName.size() >= 2 && data.shopName.size() <= 100 &&
        data.contactName is string && data.contactName.size() >= 2 && data.contactName.size() <= 80 &&
        data.location is string && data.location.size() >= 2 && data.location.size() <= 80 &&
        data.chairs is string && data.chairs.size() <= 20 &&
        data.chairs in ['1-2 Chairs', '3-5 Chairs', '6+ Chairs'] &&
        data.phone is string && data.phone.size() <= 30 &&
        data.status is string && data.status.size() <= 24 &&
        data.status in ['submitted', 'contacted', 'tester_dispatched', 'partnered', 'closed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
          'userId', 'authorName', 'location', 'beardStage',
          'rating', 'comment', 'published', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'authorName', 'location', 'beardStage',
          'rating', 'comment', 'published', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 60 &&
        data.location is string && data.location.size() <= 60 &&
        data.beardStage is string && data.beardStage.size() <= 16 &&
        data.beardStage in ['stubble', 'short', 'medium', 'full'] &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 500 &&
        data.published is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection 1: Batch 001 Editions (Public Read, Admin Write)
    // -------------------------------------------------------------------------
    match /editions/{editionId} {
      allow get: if isValidId(editionId) && (existing().active == true || isAdmin());
      allow list: if resource.data.active == true || isVerifiedAdminEmail();
      allow create: if isVerifiedUser() &&
        isValidId(editionId) &&
        isValidEdition(incoming()) &&
        incoming().id == editionId &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(editionId) &&
        isValidEdition(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'code', 'name', 'subtitle', 'description', 'price',
          'compareAtPrice', 'volume', 'badge', 'stockCount', 'sortOrder', 'active', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(editionId) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection 2: Private User Grooming Profiles + Ritual Logs Subcollection
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().userId == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'beardStage', 'dailyDrops', 'bottleDropsRemaining',
          'streakDays', 'lastRitualDate', 'savedArea', 'fulfillmentPref',
          'cartSingle', 'cartTwin', 'cartKit', 'updatedAt'
        ]) &&
        (isOwner(userId) || isAdmin());
      allow delete: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());

      // Master Gate Subcollection: Daily Ritual Check-Ins
      match /ritualLogs/{logId} {
        allow get: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(logId) &&
          (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isSignedIn() &&
          (isOwner(userId) || isVerifiedAdminEmail()) &&
          resource.data.userId == userId;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(logId) &&
          isOwner(userId) &&
          isValidRitualLog(incoming()) &&
          incoming().userId == userId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(logId) &&
          (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    // -------------------------------------------------------------------------
    // Collection 3: Real-Time Customer Orders (Owner + Admin Isolation)
    // -------------------------------------------------------------------------
    function isValidOrderPricing(data) {
      return (
        exists(/databases/$(database)/documents/editions/single) &&
        exists(/databases/$(database)/documents/editions/twin) &&
        exists(/databases/$(database)/documents/editions/kit)
      )
        ? data.subtotal == (
            data.qtySingle * get(/databases/$(database)/documents/editions/single).data.price +
            data.qtyTwin * get(/databases/$(database)/documents/editions/twin).data.price +
            data.qtyKit * get(/databases/$(database)/documents/editions/kit).data.price
          )
        : data.subtotal == (
            data.qtySingle * 220 +
            data.qtyTwin * 410 +
            data.qtyKit * 320
          );
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() &&
        isValidId(orderId) &&
        (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isVerifiedAdminEmail());
      allow create: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        isValidOrderPricing(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Tier 1: Apothecary Admin fulfillment progress & notes
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])) ||
          // Tier 2: Customer may cancel only while still pending (Terminal states locked)
          (
            existing().userId == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(orderId) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection 4: Maseru Barbershop & Trade Inquiries (Owner + Admin)
    // -------------------------------------------------------------------------
    match /barberInquiries/{inquiryId} {
      allow get: if isSignedIn() &&
        isValidId(inquiryId) &&
        (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isVerifiedAdminEmail());
      allow create: if isVerifiedUser() &&
        isValidId(inquiryId) &&
        isValidBarberInquiry(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'submitted' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(inquiryId) &&
        isValidBarberInquiry(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isVerifiedUser() &&
        isValidId(inquiryId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Collection 5: Verified Batch 001 Customer Reviews (Public Read, Owner Write)
    // -------------------------------------------------------------------------
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (
        existing().published == true ||
        (isSignedIn() && existing().userId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if resource.data.published == true ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        isVerifiedAdminEmail();
      allow create: if isVerifiedUser() &&
        isValidId(reviewId) &&
        isValidReview(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().published == true &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(reviewId) &&
        isValidReview(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['published', 'updatedAt'])) ||
          (
            existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'authorName', 'location', 'beardStage', 'rating', 'comment', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() &&
        isValidId(reviewId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Collection 6: Trusted Admin RBAC Registry (Server/Console Managed Only)
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if false;
    }
  }
}
